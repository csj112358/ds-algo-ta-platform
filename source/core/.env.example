# 复制本文件为 source/core/.env 并填入真实密钥（.env 已被 .gitignore 排除，不会进仓库）

# DeepSeek（或任意 OpenAI 兼容接口）的 Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# 百度千帆 AppBuilder 的 Key，百科查询工具用（注意保留 Bearer 前缀和引号）
BAIDU_WIKI_API_KEY='Bearer bce-v3/ALTAK-xxxxxxxxxxxxxxxx/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'